{
  "openapi": "3.0.3",
  "info": {
    "title": "Rr Cluster Admin Console API",
    "version": "1.0.0",
    "description": "Same-origin, read-only Console BFF API. All timestamps are RFC 3339 UTC. Missing or unsupported values are null or explicitly UNSUPPORTED, never zero. Explicit Admin seeds and trusted NodeDirectory/ConfigProvider records share one capability-aware projection; legacy AdminService UNIMPLEMENTED responses degrade only the affected feature."
  },
  "servers": [{ "url": "/api/v1/console" }],
  "security": [{ "sessionCookie": [] }],
  "paths": {
    "/summary": {
      "get": {
        "operationId": "getConsoleSummary",
        "parameters": [{ "$ref": "#/components/parameters/Window" }],
        "responses": {
          "200": { "description": "Cluster summary, possibly partial or stale", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SummaryEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/nodes": {
      "get": {
        "operationId": "listConsoleNodes",
        "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Filter" }],
        "responses": {
          "200": { "description": "Node page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/nodes/{nodeId}": {
      "get": {
        "operationId": "getConsoleNode",
        "parameters": [{ "$ref": "#/components/parameters/NodeId" }],
        "responses": {
          "200": { "description": "Node and local Raft observations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/nodes/{nodeId}/boots": {
      "get": {
        "operationId": "listConsoleNodeBoots",
        "parameters": [{ "$ref": "#/components/parameters/NodeId" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/PageSize" }],
        "responses": {
          "200": { "description": "Node-owned boot records with an opaque upstream history cursor and persistence mode; legacy nodes return an empty page plus UNSUPPORTED boot_history", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "504": { "$ref": "#/components/responses/HandlerDeadline" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/topology": {
      "get": {
        "operationId": "getConsoleTopology",
        "parameters": [
          { "name": "view", "in": "query", "schema": { "type": "string", "enum": ["nodes", "raft", "routes"], "default": "nodes" } },
          { "name": "group_id", "in": "query", "schema": { "type": "integer", "format": "uint64", "minimum": 1 } }
        ],
        "responses": {
          "200": { "description": "Requested topology projection", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/groups": {
      "get": {
        "operationId": "listConsoleGroups",
        "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Filter" }],
        "responses": {
          "200": { "description": "Raft group page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/groups/{groupId}": {
      "get": {
        "operationId": "getConsoleGroup",
        "parameters": [{ "$ref": "#/components/parameters/GroupId" }],
        "responses": {
          "200": { "description": "Group observations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/groups/{groupId}/replicas": {
      "get": {
        "operationId": "getConsoleGroupReplicas",
        "parameters": [{ "$ref": "#/components/parameters/GroupId" }, { "name": "node_id", "in": "query", "description": "Seed used for on-demand detail collection", "schema": { "type": "integer", "format": "uint64", "minimum": 1 } }],
        "responses": {
          "200": { "description": "On-demand legacy and full replica evidence. Flat matched/lag/heartbeat fields are projected only from leader evidence and retain leader_replication; local and cluster commit indexes remain distinct; deprecated snapshot_in_progress is not returned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "504": { "$ref": "#/components/responses/HandlerDeadline" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/metrics/performance": {
      "get": {
        "operationId": "getConsolePerformance",
        "parameters": [{ "$ref": "#/components/parameters/Window" }, { "name": "group_id", "in": "query", "schema": { "type": "integer", "format": "uint64" } }, { "name": "node_id", "in": "query", "schema": { "type": "integer", "format": "uint64" } }, { "name": "op", "in": "query", "schema": { "type": "string" } }, { "name": "source", "in": "query", "schema": { "type": "string", "enum": ["CONSOLE_MEMORY", "PROMETHEUS"] }, "description": "Select bounded live retention or fixed-template Prometheus history" }],
        "responses": {
          "200": { "description": "Reset-safe live rates and aggregate histogram quantiles, or fixed-template Prometheus history. UNMAPPED and UNSUPPORTED are explicit; server/proposal/apply cohorts are never subtracted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/snapshots": {
      "get": {
        "operationId": "listConsoleSnapshots",
        "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/PageSize" }, { "name": "group_id", "in": "query", "schema": { "type": "integer", "format": "uint64" } }, { "name": "node_id", "in": "query", "schema": { "type": "integer", "format": "uint64" } }],
        "responses": {
          "200": { "description": "Snapshot indexes plus reset-safe install and transfer rates when trusted metrics are available; node-only build failures never become group facts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageEnvelope" } } } },
          "504": { "$ref": "#/components/responses/HandlerDeadline" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/lifecycle": {
      "get": {
        "operationId": "getConsoleLifecycle",
        "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/PageSize" }, { "name": "view", "in": "query", "schema": { "type": "string", "enum": ["current", "restarts", "versions"], "default": "current" } }],
        "responses": {
          "200": { "description": "Current build/boot state, restart history, or version history using bounded cached node boot-journal pages; unsupported nodes are identified by capability", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "504": { "$ref": "#/components/responses/HandlerDeadline" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "listConsoleEvents",
        "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/PageSize" }, { "name": "severity", "in": "query", "schema": { "type": "string", "enum": ["INFO", "WARN", "ERROR"] } }, { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["ACTIVE", "RESOLVED"] } }],
        "responses": {
          "200": { "description": "Bounded in-memory observation event page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/sources": {
      "get": {
        "operationId": "getConsoleSources",
        "responses": {
          "200": { "description": "Explicit-seed or trusted-discovery source health, directory revisions, identity quarantine, capabilities and retention", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/sources/reconcile": {
      "post": {
        "operationId": "reconcileConsoleSources",
        "description": "Runs or joins the single shared collection flight. Requires a same-origin Origin header and, when viewer authentication is enabled, X-Console-CSRF.",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "200": { "description": "Reconciliation completed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/stream": {
      "get": {
        "operationId": "streamConsoleUpdates",
        "description": "Server-sent summary events. A resync event asks the client to perform a full GET after lag.",
        "responses": {
          "200": { "description": "SSE stream", "content": { "text/event-stream": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "loginConsoleViewer",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["token"], "properties": { "token": { "type": "string", "format": "password" } } } } } },
        "responses": {
          "200": { "description": "Viewer session created", "headers": { "Set-Cookie": { "description": "HttpOnly; SameSite=Strict; Secure on HTTPS", "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/auth/csrf": {
      "get": {
        "operationId": "getConsoleCsrf",
        "responses": {
          "200": { "description": "CSRF token and expiry for the current viewer session; does not create or rotate a session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutConsoleViewer",
        "responses": {
          "200": { "description": "Session revoked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "rr_console_session" }
    },
    "parameters": {
      "NodeId": { "name": "nodeId", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64", "minimum": 1 } },
      "GroupId": { "name": "groupId", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64", "minimum": 1 } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string" } },
      "PageSize": { "name": "page_size", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
      "Filter": { "name": "filter", "in": "query", "schema": { "type": "string" } },
      "Window": { "name": "window", "in": "query", "schema": { "type": "string", "examples": ["15m", "1h", "6h", "24h"] } },
      "CsrfToken": { "name": "X-Console-CSRF", "in": "header", "required": false, "description": "Required when viewer authentication is enabled", "schema": { "type": "string" } }
    },
    "responses": {
      "BadRequest": { "description": "Invalid argument with uniform metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "Unauthenticated": { "description": "Missing, expired or invalid viewer session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "Forbidden": { "description": "CSRF or Origin check failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "NotFound": { "description": "Resource or API route not found with uniform metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "UpstreamError": { "description": "Upstream collection failed with sanitized error and uniform metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "HandlerDeadline": { "description": "On-demand collection exceeded the overall 2s handler deadline; error code HANDLER_DEADLINE_EXCEEDED", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "required": ["schema_version", "correlation_id", "cluster_id", "generated_at", "partial", "retention_source", "sources", "capabilities"],
        "properties": {
          "schema_version": { "type": "string", "const": "console.v1" },
          "correlation_id": { "type": "string", "format": "uuid" },
          "cluster_id": { "type": "string" },
          "generated_at": { "type": "string", "format": "date-time" },
          "partial": { "type": "boolean" },
          "time_window": { "type": "string", "nullable": true },
          "retention_source": { "type": "string", "enum": ["CONSOLE_MEMORY", "PROMETHEUS", "NONE", "UNKNOWN"] },
          "sources": { "type": "array", "items": { "$ref": "#/components/schemas/SourceMeta" } },
          "capabilities": { "type": "array", "items": { "$ref": "#/components/schemas/Capability" } }
        }
      },
      "SourceMeta": {
        "type": "object",
        "required": ["node_id", "endpoint_role", "observed_at", "age_ms", "status"],
        "properties": {
          "node_id": { "type": "integer", "format": "uint64" },
          "endpoint_role": { "type": "string", "enum": ["ADMIN", "OBSERVABILITY", "METRICS", "HEALTH", "READY", "PROMETHEUS_HISTORY", "DISCOVERY"] },
          "observed_at": { "type": "string", "format": "date-time", "nullable": true },
          "age_ms": { "type": "integer", "format": "uint64", "nullable": true },
          "status": { "type": "string", "enum": ["ONLINE", "STALE", "UNREACHABLE", "ERROR", "UNMAPPED", "UNSUPPORTED", "UNKNOWN"] },
          "error_code": { "type": "string", "nullable": true }
        }
      },
      "Capability": {
        "type": "object",
        "required": ["feature", "status"],
        "properties": {
          "feature": { "type": "string" },
          "status": { "type": "string", "enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED", "UNTRACKED", "UNMAPPED", "ERROR", "ON_DEMAND", "OBSERVED"] },
          "reason": { "type": "string", "nullable": true }
        }
      },
      "ProtocolVersion": {
        "type": "object",
        "properties": {
          "major": { "type": "integer", "format": "uint32" },
          "minor": { "type": "integer", "format": "uint32" },
          "min_peer_minor": { "type": "integer", "format": "uint32" }
        }
      },
      "VersionCompatibility": {
        "type": "object",
        "required": ["status", "incompatible_node_ids"],
        "properties": {
          "status": { "type": "string", "enum": ["COMPATIBLE", "INCOMPATIBLE", "UNKNOWN"] },
          "reason": { "type": "string", "nullable": true },
          "incompatible_node_ids": { "type": "array", "items": { "type": "integer", "format": "uint64" } }
        }
      },
      "BuildInfo": {
        "type": "object",
        "properties": {
          "rr_version": { "type": "string" },
          "app_version": { "type": "string" },
          "git_commit": { "type": "string" },
          "git_dirty": { "type": "boolean", "description": "Legacy alias of dirty" },
          "dirty": { "type": "boolean" },
          "build_profile": { "type": "string", "description": "Legacy alias of profile" },
          "profile": { "type": "string" },
          "admin_api": { "$ref": "#/components/schemas/ProtocolVersion" },
          "raft_wire": { "$ref": "#/components/schemas/ProtocolVersion" },
          "admin_protocol": { "$ref": "#/components/schemas/ProtocolVersion" },
          "raft_protocol": { "$ref": "#/components/schemas/ProtocolVersion" },
          "boot_id": { "type": "string" },
          "process_start_time": { "type": "string", "format": "date-time", "nullable": true },
          "config_fingerprint": { "type": "string", "description": "Secret-free deterministic configuration fingerprint" }
        }
      },
      "BootRecord": {
        "type": "object",
        "properties": {
          "node_id": { "type": "integer", "format": "uint64", "nullable": true },
          "boot_id": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time", "nullable": true },
          "ended_at": { "type": "string", "format": "date-time", "nullable": true },
          "shutdown_state": { "type": "string", "enum": ["RUNNING", "GRACEFUL", "ABNORMAL_OR_UNCERTAIN"] },
          "persistence": { "type": "string", "enum": ["PERSISTENT", "VOLATILE"], "nullable": true },
          "app_version": { "type": "string", "nullable": true },
          "rr_version": { "type": "string", "nullable": true },
          "git_commit": { "type": "string", "nullable": true },
          "git_dirty": { "type": "boolean", "nullable": true },
          "dirty": { "type": "boolean", "nullable": true },
          "build_profile": { "type": "string", "nullable": true },
          "profile": { "type": "string", "nullable": true },
          "config_fingerprint": { "type": "string", "nullable": true },
          "admin_api": { "$ref": "#/components/schemas/ProtocolVersion" },
          "raft_wire": { "$ref": "#/components/schemas/ProtocolVersion" },
          "admin_protocol": { "$ref": "#/components/schemas/ProtocolVersion" },
          "raft_protocol": { "$ref": "#/components/schemas/ProtocolVersion" },
          "compatibility": { "allOf": [{ "$ref": "#/components/schemas/VersionCompatibility" }], "nullable": true, "description": "Current boots use current same-group peer evidence; historical boots are UNKNOWN" },
          "current": { "type": "boolean", "nullable": true },
          "build": { "$ref": "#/components/schemas/BuildInfo" }
        }
      },
      "ResourceEvidence": {
        "type": "object",
        "required": ["name", "labels", "value", "rate"],
        "properties": {
          "name": { "type": "string" },
          "labels": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Complete scope/kind/mount label set; label variants are never overwritten" },
          "value": { "type": "number", "nullable": true },
          "rate": { "type": "boolean", "description": "True for reset-safe per-second counter rates, false for raw samples" }
        }
      },
      "FilesystemSample": {
        "type": "object",
        "properties": {
          "scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "mount": { "type": "string", "nullable": true },
          "used_bytes": { "type": "number", "nullable": true },
          "total_bytes": { "type": "number", "nullable": true }
        }
      },
      "ResourceSample": {
        "type": "object",
        "properties": {
          "observed_at": { "type": "string", "format": "date-time", "nullable": true },
          "sampled_at": { "type": "string", "format": "date-time", "nullable": true },
          "metrics": { "type": "object", "additionalProperties": { "type": "number", "nullable": true }, "description": "Legacy metric-name projection retained for compatibility; samples is the lossless evidence list" },
          "samples": { "type": "array", "items": { "$ref": "#/components/schemas/ResourceEvidence" } },
          "cpu_usage_ratio": { "type": "number", "nullable": true },
          "cpu_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "cpu_cores": { "type": "number", "nullable": true },
          "cpu_cores_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "cpu_limit_cores": { "type": "number", "nullable": true },
          "cpu_limit_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "memory_used_bytes": { "type": "number", "nullable": true },
          "memory_total_bytes": { "type": "number", "nullable": true },
          "memory_limit_bytes": { "type": "number", "nullable": true },
          "memory_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "memory_used_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "memory_total_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "memory_limit_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "network_rx_bytes_per_sec": { "type": "number", "nullable": true },
          "network_tx_bytes_per_sec": { "type": "number", "nullable": true },
          "network_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "network_rx_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "network_tx_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "filesystem_used_bytes": { "type": "number", "nullable": true },
          "filesystem_total_bytes": { "type": "number", "nullable": true },
          "filesystem_scope": { "type": "string", "enum": ["process", "cgroup", "host"], "nullable": true },
          "filesystem_mount": { "type": "string", "nullable": true },
          "filesystems": { "type": "array", "items": { "$ref": "#/components/schemas/FilesystemSample" }, "description": "All observed mounts; flat filesystem fields select root when available, otherwise the first mount" }
        }
      },
      "Node": {
        "type": "object",
        "properties": {
          "node_id": { "type": "integer", "format": "uint64" },
          "admin_addr": { "type": "string" },
          "listen_addr": { "type": "string", "nullable": true },
          "client_addr": { "type": "string", "nullable": true },
          "observability_addr": { "type": "string", "nullable": true },
          "advertise_addr": { "type": "string", "nullable": true },
          "environment": { "type": "string", "nullable": true },
          "region": { "type": "string", "nullable": true },
          "zone": { "type": "string", "nullable": true },
          "rack": { "type": "string", "nullable": true },
          "directory_revision": { "type": "integer", "format": "uint64", "nullable": true },
          "status": { "type": "string", "enum": ["ONLINE", "DEGRADED", "STALE", "UNREACHABLE", "UNKNOWN"] },
          "ready": { "type": "boolean", "nullable": true, "description": "Latest cached readiness probe value; null when no probe evidence is available" },
          "liveness": { "type": "boolean", "nullable": true, "description": "Latest cached health probe value; null when no probe evidence is available" },
          "ready_phase": { "type": "string", "nullable": true, "description": "Node-reported readiness phase, retained even when ready is false" },
          "group_ids": { "type": "array", "items": { "type": "integer", "format": "uint64" } },
          "leader_group_count": { "type": "integer", "format": "uint64", "nullable": true },
          "uptime_secs": { "type": "integer", "format": "uint64", "nullable": true },
          "last_success": { "type": "string", "format": "date-time", "nullable": true },
          "resources": { "allOf": [{ "$ref": "#/components/schemas/ResourceSample" }], "nullable": true, "description": "Flat UI values plus lossless labeled resource evidence; null when unavailable" },
          "build": { "$ref": "#/components/schemas/BuildInfo" },
          "boot": {
            "type": "object",
            "nullable": true,
            "properties": {
              "persistence": { "type": "string", "enum": ["PERSISTENT", "VOLATILE"] },
              "current": { "$ref": "#/components/schemas/BootRecord" }
            }
          }
        }
      },
      "GroupObservation": {
        "type": "object",
        "properties": {
          "node_id": { "type": "integer", "format": "uint64" },
          "group_id": { "type": "integer", "format": "uint64" },
          "is_leader": { "type": "boolean" },
          "current_term": { "type": "integer", "format": "uint64" },
          "last_log_index": { "type": "integer", "format": "uint64" },
          "leader_node_id": { "type": "integer", "format": "uint64", "nullable": true, "description": "Legacy leader_node_id=0 is normalized to null" },
          "observed_at": { "type": "string", "format": "date-time" }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "group_id": { "type": "integer", "format": "uint64" },
          "health": { "type": "string", "enum": ["HEALTHY", "DEGRADED", "LEADERLESS_OBSERVED", "QUORUM_AT_RISK", "CONFLICTING_VIEWS", "SYNCING"] },
          "leader_node_id": { "type": "integer", "format": "uint64", "nullable": true },
          "current_term": { "type": "integer", "format": "uint64", "nullable": true },
          "last_log_index": { "type": "integer", "format": "uint64", "nullable": true },
          "expected_replica_node_ids": { "type": "array", "items": { "type": "integer", "format": "uint64" } },
          "voters_reachable": { "type": "integer", "description": "Fresh reachable members of expected_replica_node_ids, not a Raft quorum proof" },
          "reachable_voters": { "type": "integer", "description": "Legacy alias for voters_reachable" },
          "voters_total": { "type": "integer", "nullable": true },
          "source_count": { "type": "integer" },
          "observations": { "type": "array", "items": { "$ref": "#/components/schemas/GroupObservation" } }
        }
      },
      "LeaderReplication": {
        "type": "object",
        "properties": {
          "node_id": { "type": "integer", "format": "uint64" },
          "matched_index": { "type": "integer", "format": "uint64", "nullable": true },
          "lag_entries": { "type": "integer", "format": "uint64", "nullable": true },
          "last_heartbeat": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Replica": {
        "type": "object",
        "properties": {
          "node_id": { "type": "integer", "format": "uint64" },
          "group_id": { "type": "integer", "format": "uint64" },
          "server_state": { "type": "string", "nullable": true },
          "current_term": { "type": "integer", "format": "uint64" },
          "last_log_index": { "type": "integer", "format": "uint64", "nullable": true },
          "commit_index": { "type": "integer", "format": "uint64", "nullable": true, "description": "Local commit index for the UI; local_commit_index remains as an explicit alias" },
          "local_commit_index": { "type": "integer", "format": "uint64", "nullable": true },
          "cluster_commit_index": { "type": "integer", "format": "uint64", "nullable": true },
          "applied_index": { "type": "integer", "format": "uint64", "nullable": true },
          "matched_index": { "type": "integer", "format": "uint64", "nullable": true, "description": "Leader-observed matched index; null when no leader supplied evidence" },
          "lag_entries": { "type": "integer", "format": "uint64", "nullable": true, "description": "Leader-observed lag; null is never normalized to zero" },
          "heartbeat_age_ms": { "type": "integer", "format": "uint64", "nullable": true },
          "source_node_id": { "type": "integer", "format": "uint64", "nullable": true, "description": "Leader source for matched/lag/heartbeat evidence, otherwise the local source" },
          "local_source_node_id": { "type": "integer", "format": "uint64", "nullable": true },
          "leader_observed_at": { "type": "string", "format": "date-time", "nullable": true },
          "local_observed_at": { "type": "string", "format": "date-time", "nullable": true, "description": "Local sample time retained when observed_at is aligned to leader evidence" },
          "leader_node_id": { "type": "integer", "format": "uint64", "nullable": true },
          "leader_view": { "type": "string", "enum": ["LEADER", "NOT_LEADER_SOURCE"], "nullable": true },
          "leader_replication": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/LeaderReplication" } },
          "last_snapshot_index": { "type": "integer", "format": "uint64", "nullable": true },
          "last_snapshot_term": { "type": "integer", "format": "uint64", "nullable": true },
          "observed_at": { "type": "string", "format": "date-time", "description": "Observation time for source_node_id; local_observed_at retains a local sample time when leader evidence is joined" }
        }
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "group_id": { "type": "integer", "format": "uint64" },
          "node_id": { "type": "integer", "format": "uint64" },
          "last_log_index": { "type": "integer", "format": "uint64" },
          "last_snapshot_index": { "type": "integer", "format": "uint64", "nullable": true },
          "last_snapshot_term": { "type": "integer", "format": "uint64", "nullable": true },
          "snapshot_distance": { "type": "integer", "format": "uint64", "nullable": true },
          "install_count": { "type": "number", "nullable": true, "description": "Current raw install counter; never inferred from snapshot indexes" },
          "install_rate": { "type": "number", "nullable": true, "description": "Reset-safe installs per second after the first scrape" },
          "send_bytes_per_second": { "type": "number", "nullable": true },
          "recv_bytes_per_second": { "type": "number", "nullable": true },
          "source_count": { "type": "integer", "format": "uint64" },
          "build_failure_status": { "type": "string", "const": "UNSUPPORTED" },
          "observed_at": { "type": "string", "format": "date-time" }
        }
      },
      "Page": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": {} },
          "next_cursor": { "type": "string", "nullable": true, "description": "Opaque Console or node boot-journal cursor; clients must not parse it" },
          "persistence": { "type": "string", "enum": ["PERSISTENT", "VOLATILE"], "nullable": true }
        }
      },
      "Envelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": { "data": {}, "meta": { "$ref": "#/components/schemas/Meta" } }
      },
      "PageEnvelope": {
        "allOf": [
          { "$ref": "#/components/schemas/Envelope" },
          { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Page" } } }
        ]
      },
      "SummaryEnvelope": {
        "allOf": [
          { "$ref": "#/components/schemas/Envelope" },
          { "type": "object", "properties": { "data": { "type": "object", "properties": { "nodes": { "type": "array", "items": { "$ref": "#/components/schemas/Node" } }, "groups": { "type": "array", "items": { "$ref": "#/components/schemas/Group" } } } } } }
        ]
      },
      "ErrorBody": {
        "type": "object",
        "required": ["code", "message"],
        "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "meta"],
        "properties": { "error": { "$ref": "#/components/schemas/ErrorBody" }, "meta": { "$ref": "#/components/schemas/Meta" } }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["csrf_token", "expires_at", "meta"],
        "properties": {
          "csrf_token": { "type": "string", "format": "uuid", "nullable": true },
          "expires_at": { "type": "string", "format": "date-time", "nullable": true },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      }
    }
  }
}
