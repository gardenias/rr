# Copy to deploy/perf/.env and fill in real values. `.env` is gitignored —
# never commit it. Tokens are injected into the kv-store containers as
# environment variables (same semantics as K8s Secrets); the nodes read them
# in TLS mode and enforce them on the Admin/Client gRPC services.
#
# Generate strong local values with:  openssl rand -hex 24

RR_ADMIN_TOKEN=change-me-admin-token
RR_CLIENT_TOKEN=change-me-client-token

# Optional: dedicated cpusets per container (Linux hosts; on macOS Docker
# Desktop they apply to the VM). Defaults assume an >=8-core host.
# Numbers are only comparable within the same quota matrix — record the
# actual quotas in every report's meta section.
#KV1_CPUSET=0-1
#KV2_CPUSET=2-3
#KV3_CPUSET=4-5
#BENCH_CPUSET=6-7

# Optional: kv node memory limit (default 2g). Raise for the 16KiB-payload
# tier — see README "Known cliff".
#KV_MEM_LIMIT=2g

# Optional: Grafana admin credentials (published on 127.0.0.1:3100).
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin

# Optional: snapshot trigger threshold for the kv nodes (default 50000,
# ADR A-0008). W7 snapshot-pressure runs lower it (e.g. 5000).
#SNAPSHOT_LOGS_SINCE_LAST=50000
